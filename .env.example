# Plain HTTP on the server IP. Use this for a first test.
SITE_ADDRESS=:80

# After a name points at the server, switch to that name for free HTTPS.
# Examples: layout.example.com   or   203.0.113.10.sslip.io
# SITE_ADDRESS=layout.example.com

# At least 32 random characters. Do not reuse the local demo key.
JWT_KEY=replace-with-a-long-random-secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Hidden full-access account. It is not shown on the Users page.
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional. Sketch extraction still runs without it.
OPENAI_API_KEY=
