@page "/inquiries"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject RealEstateApiClient Api

<PageTitle>Inquiries</PageTitle>

<h1>Inquiries</h1>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<button class="btn btn-primary mb-3" @onclick="StartNew">New inquiry</button>

@if (editing is not null)
{
    <EditForm Model="editing" OnValidSubmit="SaveAsync" class="card p-3 mb-4">
        <DataAnnotationsValidator />
        <h2>@(editing.Id == 0 ? "New inquiry" : "Edit inquiry")</h2>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Client name</label>
                <InputText class="form-control" @bind-Value="editing.ClientName" />
                <ValidationMessage For="() => editing.ClientName" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Phone number</label>
                <InputText class="form-control" @bind-Value="editing.Phone" />
                <ValidationMessage For="() => editing.Phone" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Interested in</label>
                <InputSelect class="form-select" @bind-Value="editing.LayoutPlanId">
                    <option value="">No sketch</option>
                    @foreach (var sketch in sketches)
                    {
                        <option value="@sketch.Id">@sketch.Name</option>
                    }
                </InputSelect>
            </div>
            <div class="col-12">
                <label class="form-label">Message</label>
                <InputTextArea class="form-control" @bind-Value="editing.Message" />
                <ValidationMessage For="() => editing.Message" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Save</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
}

<div class="d-flex align-items-center gap-2 mb-2">
    <label class="form-label mb-0" for="sketch-filter">Interested in</label>
    <select id="sketch-filter" class="form-select" style="max-width: 16rem;" @bind="sketchFilter">
        <option value="all">All sketches</option>
        <option value="none">No sketch</option>
        @foreach (var sketch in sketches)
        {
            <option value="@sketch.Id">@sketch.Name</option>
        }
    </select>
</div>

<div class="table-scroll">
<table class="table table-hover">
    <thead>
        <tr><th>Client name</th><th>Phone number</th><th>Interested in</th><th>Message</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var inquiry in FilteredInquiries)
        {
            <tr>
                <td>@inquiry.ClientName</td>
                <td>@inquiry.Phone</td>
                <td>@(string.IsNullOrEmpty(inquiry.LayoutName) ? "—" : inquiry.LayoutName)</td>
                <td>@inquiry.Message</td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(inquiry)">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(inquiry)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<InquiryModel> inquiries = new();
    private List<LayoutSummaryModel> sketches = new();
    private InquiryModel? editing;
    private string? error;
    private string sketchFilter = "all";

    private IEnumerable<InquiryModel> FilteredInquiries =>
        inquiries.Where(i => sketchFilter == "all"
            || (sketchFilter == "none" && i.LayoutPlanId is null)
            || i.LayoutPlanId?.ToString() == sketchFilter);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            inquiries = await Api.GetInquiriesAsync() ?? new();
            sketches = await Api.GetLayoutsAsync() ?? new();
            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void StartNew() => editing = new InquiryModel();

    private void Edit(InquiryModel inquiry) => editing = new InquiryModel
    {
        Id = inquiry.Id,
        ClientName = inquiry.ClientName,
        Phone = inquiry.Phone,
        LayoutPlanId = inquiry.LayoutPlanId,
        LayoutName = inquiry.LayoutName,
        Message = inquiry.Message
    };

    private void Cancel() => editing = null;

    private async Task SaveAsync()
    {
        if (editing is null)
        {
            return;
        }

        try
        {
            await Api.SaveInquiryAsync(editing);
            editing = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task DeleteAsync(InquiryModel inquiry)
    {
        try
        {
            await Api.DeleteInquiryAsync(inquiry.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
