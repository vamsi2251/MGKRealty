@page "/layouts/{Id:int}"
@attribute [Authorize]
@inject RealEstateApiClient Api
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState

<PageTitle>@(plan?.Name ?? "Layout")</PageTitle>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (plan is null)
{
    <p>Loading layout...</p>
}
else
{
    <BusyOverlay Visible="busy" Message="Working…" />
    <div class="d-flex justify-content-between align-items-start gap-3 stack-mobile">
        <div>
            <label class="form-label" for="saved-layout-name">Layout name</label>
            <input id="saved-layout-name" class="form-control mb-2" maxlength="120" @bind="layoutName" disabled="@(!canEdit)" />
            <p class="text-muted">@plan.PlotCount plots · @plan.TotalArea.ToString("0.##") @plan.Unit · @plan.FileName</p>
            @if (!string.IsNullOrWhiteSpace(plan.Notes))
            {
                <p>@plan.Notes</p>
            }
        </div>
        @if (canManage)
        {
            <div class="d-flex flex-column gap-2">
                @if (plan.CompletedOn is null && plan.Plots.Count > 0 && plan.Plots.All(plot => plot.Status == PlotStatus.Sold))
                {
                    <button class="btn btn-success" type="button" @onclick="CompleteAsync" disabled="@busy">
                        @if (busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Complete layout</button>
                }
                else if (plan.CompletedOn is null)
                {
                    <p class="text-muted mb-0">Complete this layout after every plot is sold.</p>
                }
                else
                {
                    <p class="text-muted mb-0">Completed @plan.CompletedOn.Value.ToLocalTime().ToString("MMM d, yyyy")</p>
                }
                <button class="btn btn-outline-danger" type="button" @onclick="DeleteAsync" disabled="@busy">
                    @if (busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Delete layout</button>
            </div>
        }
    </div>
    @if (canShare)
    {
        <div class="card p-3 my-3">
            <h2>Partners</h2>
            <p class="text-muted">Give another user this sketch. The same person can be added to more than one sketch.</p>
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-5">
                    <label class="form-label">User</label>
                    <select class="form-select" @bind="partnerUserId">
                        <option value="">Choose a user</option>
                        @foreach (var user in partnerChoices)
                        {
                            <option value="@user.Id">@user.FullName (@user.Username)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Access</label>
                    <select class="form-select" @bind="partnerLevel">
                        <option value="ReadOnly">Read only</option>
                        <option value="Editable">Editable</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary" type="button" @onclick="AddPartnerAsync" disabled="@busy">
                        @if (busy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        Add partner</button>
                </div>
            </div>
            @foreach (var partner in partners)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <span>@partner.FullName (@partner.Username)</span>
                    <span class="badge text-bg-secondary">@(partner.Level == "Editable" ? "Editable" : "Read only")</span>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => RemovePartnerAsync(partner.UserId)" disabled="@busy">Remove</button>
                </div>
            }
        </div>
    }

    <p class="text-muted">Review status: @(plan.Document?.Extraction.Status ?? "not extracted"). Provider: @(plan.Document?.Extraction.Provider ?? "none"). Extraction uses ChatGPT vision when an OpenAI API key is configured.</p>
    @if (canEdit)
    {
        <button class="btn btn-outline-primary mb-3" type="button" @onclick="ExtractAsync" disabled="@busy">
            @if (busy)
            {
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
            }
            Extract with ChatGPT</button>
    }
    <LayoutCanvas Document="plan.Document" ImageUrl="@sketchUrl" CanEdit="canEdit" DocumentChanged="OnDocumentChanged" SaveRequested="SaveDocumentAsync" />
    @if (plan.Document?.Extraction.Warnings.Count > 0)
    {
        <details class="mt-3">
            <summary>@plan.Document.Extraction.Warnings.Distinct().Count() review notes</summary>
            @foreach (var warning in plan.Document.Extraction.Warnings.Distinct())
            {
                <div class="alert alert-warning py-2 mt-2">@warning</div>
            }
        </details>
    }

    <div class="d-flex align-items-center gap-2 mb-2">
        <label class="form-label mb-0" for="status-filter">Status</label>
        <select id="status-filter" class="form-select" style="max-width: 12rem;" @bind="statusFilter">
            <option value="all">All</option>
            <option value="@PlotStatus.Available">Available</option>
            <option value="@PlotStatus.Blocked">Blocked</option>
            <option value="@PlotStatus.Sold">Sold</option>
        </select>
        @if (canEdit)
        {
            <button class="btn btn-outline-primary" type="button" @onclick="AddRowAsync" disabled="@busy">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                Add row</button>
        }
    </div>
    <div class="table-scroll">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Plot</th>
                <th>Area (cent)</th>
                <th>Facing</th>
                <th>Price</th>
                <th>Agent</th>
                <th>Client</th>
                <th>Mobile</th>
                <th>Advance</th>
                <th>Advance date</th>
                <th>Balance</th>
                <th>Registration</th>
                <th>Status</th>
                <th>Comment</th>
                <th>Survey</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var plot in FilteredPlots)
            {
                <tr>
                    <td>@plot.PlotNumber</td>
                    <td>@plot.Area.ToString("0.##")</td>
                    <td>@plot.Facing</td>
                    <td>@Money(plot.Price)</td>
                    <td>@plot.AgentName</td>
                    <td>@plot.ClientName</td>
                    <td>@plot.ClientMobile</td>
                    <td>@Money(plot.AdvanceReceived)</td>
                    <td>@When(plot.AdvanceReceivedOn)</td>
                    <td>@Money(plot.Balance)</td>
                    <td>@When(plot.RegistrationOn)</td>
                    <td>@plot.Status</td>
                    <td class="plot-comment">@plot.Comment</td>
                    <td>@(plot.HasSurvey ? plot.SurveyFileName : "")</td>
                    <td>@if (canEdit) { <button class="btn btn-sm btn-outline-primary" @onclick="() => EditAsync(plot)" disabled="@busy">Manage</button> }</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="7">Totals</th>
                <th>@Money(AdvanceTotal)</th>
                <th></th>
                <th>@Money(PendingTotal)</th>
                <th colspan="5"></th>
            </tr>
        </tfoot>
    </table>
    </div>
    <p class="text-muted">Total advances received @Money(AdvanceTotal). Total pending from clients @Money(PendingTotal). Receivable @Money(ReceivableTotal). Spent on the land owner and development @Money(SpentTotal). Profit @Money(ProfitTotal).</p>

    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card p-3 h-100">
                <h2>Land owner</h2>
                <p class="mb-1">Amount payable @Money(plan.OwnerPayable)</p>
                <p class="mb-3">Paid @Money(plan.OwnerPaid). Remaining @Money(plan.OwnerRemaining).</p>
                <button class="btn btn-outline-primary align-self-start" type="button" @onclick="() => showOwner = true">@(canEdit ? "Manage land owner" : "View land owner")</button>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card p-3 h-100">
                <h2>Development expenses</h2>
                <p class="mb-3">Development total @Money(plan.DevelopmentTotal).</p>
                <button class="btn btn-outline-primary align-self-start" type="button" @onclick="() => showExpenses = true">@(canEdit ? "Manage development expenses" : "View development expenses")</button>
            </div>
        </div>
    </div>

    @if (showOwner)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5 mb-0">Land owner</h2>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="() => showOwner = false"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label" for="owner-payable">Amount payable</label>
                        <input id="owner-payable" class="form-control mb-2" type="number" min="0" step="0.01" @bind="ownerPayable" disabled="@(!canEdit)" />
                        @if (canEdit)
                        {
                            <button class="btn btn-outline-primary mb-3" type="button" @onclick="SaveOwnerAsync" disabled="@busy">
                                @if (busy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                }
                                Save payable amount</button>
                        }
                        <p>Paid @Money(plan.OwnerPaid). Remaining @Money(plan.OwnerRemaining).</p>
                        @if (canEdit)
                        {
                        <div class="row g-2 mb-3">
                            <div class="col-md-5">
                                <label class="form-label">Payment date</label>
                                <InputDate class="form-control" @bind-Value="ownerPaidOn" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Amount</label>
                                <input class="form-control" type="number" min="0.01" step="0.01" @bind="ownerPaymentAmount" />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button class="btn btn-primary" type="button" @onclick="AddOwnerPaymentAsync" disabled="@busy">
                                    @if (busy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                    }
                                    Add payment</button>
                            </div>
                        </div>
                        }
                        @foreach (var payment in plan.OwnerPayments)
                        {
                            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                <InputDate class="form-control" style="max-width: 11rem;" @bind-Value="payment.PaidOn" disabled="@(!canEdit)" />
                                <input class="form-control" style="max-width: 9rem;" type="number" min="0.01" step="0.01" @bind="payment.Amount" disabled="@(!canEdit)" />
                                @if (canEdit)
                                {
                                    <button class="btn btn-outline-primary" type="button" @onclick="() => UpdateOwnerPaymentAsync(payment)" disabled="@busy">Update</button>
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => DeleteOwnerPaymentAsync(payment.Id)" disabled="@busy">Remove</button>
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" @onclick="() => showOwner = false">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (showExpenses)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title h5 mb-0">Development expenses</h2>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="() => showExpenses = false"></button>
                    </div>
                    <div class="modal-body">
                        <label class="form-label">Surveyor amount</label>
                        <input class="form-control mb-2" type="number" min="0" step="0.01" @bind="surveyorAmount" disabled="@(!canEdit)" />
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Tippers</label>
                                <input class="form-control" type="number" min="0" step="1" @bind="tipperCount" disabled="@(!canEdit)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Cost each</label>
                                <input class="form-control" type="number" min="0" step="0.01" @bind="tipperCost" disabled="@(!canEdit)" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tipper total</label>
                                <input class="form-control" readonly value="@Money(tipperCount * tipperCost)" />
                            </div>
                        </div>
                        <label class="form-label mt-2">Miscellaneous</label>
                        <input class="form-control mb-2" type="number" min="0" step="0.01" @bind="miscellaneousAmount" disabled="@(!canEdit)" />
                        <p>Development total @Money(surveyorAmount + (tipperCount * tipperCost) + miscellaneousAmount).</p>
                    </div>
                    <div class="modal-footer">
                        @if (canEdit)
                        {
                            <button class="btn btn-primary" type="button" @onclick="SaveExpensesAsync" disabled="@busy">
                                @if (busy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                }
                                Save expenses</button>
                        }
                        <button class="btn btn-secondary" type="button" @onclick="() => showExpenses = false">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @if (canEdit && editing is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <EditForm Model="editing" OnValidSubmit="SaveAsync">
                        <div class="modal-header">
                            <h2 class="modal-title h5 mb-0">Plot @editing.PlotNumber</h2>
                            <button type="button" class="btn-close" aria-label="Close" @onclick="Cancel"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Area (cent)</label>
                    <InputNumber class="form-control" @bind-Value="editing.Area" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Price</label>
                    <InputNumber class="form-control" @bind-Value="editing.Price" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Agent</label>
                    <InputSelect class="form-select" @bind-Value="editing.AgentId">
                        <option value="0">No agent</option>
                        @foreach (var agent in agents)
                        {
                            <option value="@agent.Id">@agent.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Client</label>
                    <InputSelect class="form-select" @bind-Value="editing.ClientId">
                        <option value="0">No client</option>
                        @foreach (var client in clients)
                        {
                            <option value="@client.Id">@client.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Mobile</label>
                    <input class="form-control" value="@SelectedClientPhone" readonly />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Advance received</label>
                    <InputNumber class="form-control" @bind-Value="editing.AdvanceReceived" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Advance received date</label>
                    <InputDate class="form-control" @bind-Value="editing.AdvanceReceivedOn" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Registration date</label>
                    <InputDate class="form-control" @bind-Value="editing.RegistrationOn" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <InputSelect class="form-select" @bind-Value="editing.Status">
                        <option value="@PlotStatus.Available">Available</option>
                        <option value="@PlotStatus.Blocked">Blocked</option>
                        @if (canManage)
                        {
                            <option value="@PlotStatus.Sold">Sold</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12">
                    <label class="form-label">Comment</label>
                    <InputTextArea class="form-control" rows="3" maxlength="1000" @bind-Value="editing.Comment" />
                    <div class="form-text">Add a note when this plot is split or needs an explanation.</div>
                </div>
                <div class="col-12">
                    <label class="form-label">Survey sketch</label>
                    <InputFile class="form-control" accept=".png,.jpg,.jpeg,image/png,image/jpeg" OnChange="SelectSurveyAsync" />
                    <div class="form-text">JPG, JPEG, or PNG, up to 8 MB.</div>
                    @if (!string.IsNullOrEmpty(surveyPreview))
                    {
                        <img class="survey-preview" src="@surveyPreview" alt="Survey sketch for plot @editing.PlotNumber" />
                    }
                    @if (editing.HasSurvey || surveyBytes is not null)
                    {
                        <button class="btn btn-sm btn-outline-danger mt-2" type="button" @onclick="ClearSurvey">Remove survey sketch</button>
                    }
                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-primary" type="submit" disabled="@busy">
                                @if (busy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                }
                                Save booking</button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="Cancel">Cancel</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private LayoutDetailModel? plan;
    private List<AgentModel> agents = new();
    private List<ClientModel> clients = new();
    private string layoutName = "";
    private PlotModel? editing;
    private string? sketchUrl;
    private byte[]? surveyBytes;
    private string? surveyName;
    private string? surveyPreview;
    private bool removeSurvey;
    private string? error;
    private bool busy;
    private bool canManage;
    private bool canEdit;
    private bool canShare;
    private List<UserModel> partnerChoices = new();
    private List<LayoutPartnerModel> partners = new();
    private string partnerUserId = "";
    private string partnerLevel = "ReadOnly";
    private string? userName;
    private string statusFilter = "all";
    private decimal ownerPayable;
    private DateTime ownerPaidOn = DateTime.Today;
    private decimal ownerPaymentAmount;
    private decimal surveyorAmount;
    private int tipperCount;
    private decimal tipperCost;
    private decimal miscellaneousAmount;
    private bool showOwner;
    private bool showExpenses;

    private IEnumerable<PlotModel> FilteredPlots =>
        plan?.Plots.Where(plot => statusFilter == "all" || plot.Status.ToString() == statusFilter) ?? [];

    private decimal AdvanceTotal => plan?.Plots.Sum(plot => plot.AdvanceReceived) ?? 0;
    private decimal PendingTotal => plan?.Plots.Sum(plot => plot.Price - plot.AdvanceReceived) ?? 0;
    private decimal ReceivableTotal => AdvanceTotal + PendingTotal;
    private decimal SpentTotal => (plan?.OwnerPaid ?? 0) + (plan?.DevelopmentTotal ?? 0);
    private decimal ProfitTotal => ReceivableTotal - SpentTotal;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        userName = state.User.Identity?.Name;
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            plan = await Api.GetLayoutAsync(Id);
            layoutName = plan?.Name ?? "";
            CopyFinance();
            canManage = plan?.CanManage == true;
            canEdit = plan?.CanEdit == true;
            canShare = plan?.CanShare == true;
            if (canShare)
            {
                partnerChoices = await Api.GetPartnerUsersAsync(Id) ?? new();
                partners = await Api.GetPartnersAsync(Id) ?? new();
            }
            sketchUrl = null;
            if (plan?.HasImage == true)
            {
                var image = await Api.GetSketchImageAsync(Id);
                if (image is not null)
                {
                    sketchUrl = $"data:{image.Value.ContentType};base64,{Convert.ToBase64String(image.Value.Bytes)}";
                }
            }

            agents = await Api.GetAgentsAsync() ?? new();
            clients = await Api.GetClientsAsync() ?? new();
            error = plan is null ? "Layout not found." : null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task EditAsync(PlotModel plot)
    {
        editing = new PlotModel
        {
            Id = plot.Id,
            PlotNumber = plot.PlotNumber,
            Area = plot.Area,
            Price = plot.Price,
            AgentId = plot.AgentId,
            ClientId = plot.ClientId,
            ClientName = plot.ClientName,
            ClientMobile = plot.ClientMobile,
            AdvanceReceived = plot.AdvanceReceived,
            AdvanceReceivedOn = plot.AdvanceReceivedOn,
            RegistrationOn = plot.RegistrationOn,
            Status = plot.Status,
            Comment = plot.Comment ?? "",
            HasSurvey = plot.HasSurvey,
            SurveyFileName = plot.SurveyFileName
        };
        surveyBytes = null;
        surveyName = null;
        surveyPreview = null;
        removeSurvey = false;
        if (!plot.HasSurvey)
        {
            return;
        }

        busy = true;
        StateHasChanged();
        try
        {
            var image = await Api.GetPlotSurveyAsync(plot.Id);
            if (image is not null)
            {
                surveyPreview = $"data:{image.Value.ContentType};base64,{Convert.ToBase64String(image.Value.Bytes)}";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SelectSurveyAsync(InputFileChangeEventArgs args)
    {
        try
        {
            var file = args.File;
            await using var stream = file.OpenReadStream(8_000_000);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            surveyBytes = buffer.ToArray();
            surveyName = file.Name;
            removeSurvey = false;
            if (editing is not null)
            {
                editing.HasSurvey = true;
                editing.SurveyFileName = file.Name;
            }

            var contentType = file.Name.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "image/png" : "image/jpeg";
            surveyPreview = $"data:{contentType};base64,{Convert.ToBase64String(surveyBytes)}";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void ClearSurvey()
    {
        surveyBytes = null;
        surveyName = null;
        surveyPreview = null;
        removeSurvey = true;
        if (editing is not null)
        {
            editing.HasSurvey = false;
            editing.SurveyFileName = null;
        }
    }

    private string SelectedClientPhone =>
        clients.FirstOrDefault(client => client.Id == editing?.ClientId)?.Phone ?? "";

    private void Cancel()
    {
        editing = null;
        surveyBytes = null;
        surveyName = null;
        surveyPreview = null;
        removeSurvey = false;
    }

    private async Task SaveAsync()
    {
        if (editing is null)
        {
            return;
        }

        if (editing.AdvanceReceived > 0 && editing.Status == PlotStatus.Available)
        {
            editing.Status = PlotStatus.Blocked;
        }

        busy = true;
        StateHasChanged();
        try
        {
            await Api.SaveBookingAsync(editing);
            if (removeSurvey)
            {
                await Api.DeletePlotSurveyAsync(editing.Id);
            }
            else if (surveyBytes is not null && !string.IsNullOrWhiteSpace(surveyName))
            {
                using var stream = new MemoryStream(surveyBytes);
                await Api.UploadPlotSurveyAsync(editing.Id, stream, surveyName);
            }

            editing = null;
            surveyBytes = null;
            surveyName = null;
            surveyPreview = null;
            removeSurvey = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

