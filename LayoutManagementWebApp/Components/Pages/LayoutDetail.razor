    private string ViewBox
    {
        get
        {
            var points = plan?.Plots.SelectMany(p => p.Vertices).ToList() ?? new();
            if (points.Count == 0)
            {
                return "0 0 100 100";
            }

            var minX = points.Min(p => p.X);
            var minY = points.Min(p => p.Y);
            var maxX = points.Max(p => p.X);
            var maxY = points.Max(p => p.Y);
            var pad = 4;
            return $"{minX - pad} {-(maxY + pad)} {maxX - minX + pad * 2} {maxY - minY + pad * 2}";
        }
    }

    private MarkupString MapShapes
    {
        get
        {
            if (plan is null)
            {
                return new MarkupString(string.Empty);
            }

            var road = plan.Unit == "cent"
                ? "<rect x=\"40\" y=\"-340\" width=\"30\" height=\"340\" class=\"plot-road\"></rect><text x=\"55\" y=\"-170\" class=\"road-label\">30' road</text>"
                : "";
            var shapes = string.Concat(plan.Plots.Select(plot =>
            {
                var center = Center(plot);
                var number = System.Net.WebUtility.HtmlEncode(plot.PlotNumber);
                var area = System.Net.WebUtility.HtmlEncode(plot.Area.ToString("0.##"));
                return $"<polygon points=\"{Points(plot)}\" class=\"plot-shape {plot.Status.ToString().ToLowerInvariant()}\"></polygon><text x=\"{center.X}\" y=\"{center.Y - 3}\">{number}</text><text x=\"{center.X}\" y=\"{center.Y + 4}\" class=\"plot-area\">{area}</text>";
            }));
            return new MarkupString(road + shapes);
        }
    }

    private static string Points(PlotModel plot) =>
        string.Join(" ", plot.Vertices.Select(v => $"{v.X},{-v.Y}"));

    private static SketchPointModel Center(PlotModel plot)
    {
        if (plot.Vertices.Count == 0)
        {
            return new SketchPointModel();
        }

        return new SketchPointModel
        {
            X = plot.Vertices.Average(v => v.X),
            Y = -plot.Vertices.Average(v => v.Y)
        };
    }

    private void CopyFinance()
    {
        if (plan is null)
        {
            return;
        }

        ownerPayable = plan.OwnerPayable;
        surveyorAmount = plan.SurveyorAmount;
        tipperCount = plan.TipperCount;
        tipperCost = plan.TipperCost;
        miscellaneousAmount = plan.MiscellaneousAmount;
    }

    private void ApplyFinance(LayoutDetailModel? updated)
    {
        if (plan is null || updated is null)
        {
            return;
        }

        plan.OwnerPayable = updated.OwnerPayable;
        plan.OwnerPaid = updated.OwnerPaid;
        plan.OwnerRemaining = updated.OwnerRemaining;
        plan.OwnerPayments = updated.OwnerPayments;
        plan.SurveyorAmount = updated.SurveyorAmount;
        plan.TipperCount = updated.TipperCount;
        plan.TipperCost = updated.TipperCost;
        plan.TipperTotal = updated.TipperTotal;
        plan.MiscellaneousAmount = updated.MiscellaneousAmount;
        plan.DevelopmentTotal = updated.DevelopmentTotal;
        CopyFinance();
        error = null;
    }

