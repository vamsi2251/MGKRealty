@page "/clients"
@attribute [Authorize]
@inject RealEstateApiClient Api

<PageTitle>Clients</PageTitle>

<h1>Clients</h1>

<BusyOverlay Visible="busy" Message="Working…" />

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<button class="btn btn-primary mb-3" @onclick="StartNew">New client</button>

@if (editing is not null)
{
    <EditForm Model="editing" OnValidSubmit="SaveAsync" class="card p-3 mb-4">
        <DataAnnotationsValidator />
        <h2>@(editing.Id == 0 ? "New client" : "Edit client")</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="editing.Name" />
                <ValidationMessage For="() => editing.Name" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Email (optional)</label>
                <InputText class="form-control" @bind-Value="editing.Email" />
                <ValidationMessage For="() => editing.Email" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <InputText class="form-control" @bind-Value="editing.Phone" />
                <ValidationMessage For="() => editing.Phone" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Type</label>
                <InputSelect class="form-select" @bind-Value="editing.ClientType">
                    @foreach (var value in Enum.GetValues<ClientType>())
                    {
                        <option value="@value">@value</option>
                    }
                </InputSelect>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit" disabled="@busy">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                }
                Save</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="Cancel">Cancel</button>
        </div>
    </EditForm>
}

<div class="table-scroll">
<table class="table table-hover">
    <thead>
        <tr><th>Name</th><th>Email</th><th>Phone</th><th>Type</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var client in clients)
        {
            <tr>
                <td>@client.Name</td>
                <td>@client.Email</td>
                <td>@client.Phone</td>
                <td>@client.ClientType</td>
                <td class="text-nowrap">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(client)">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(client)" disabled="@busy">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@code {
    private List<ClientModel> clients = new();
    private ClientModel? editing;
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            clients = await Api.GetClientsAsync() ?? new();
            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void StartNew() => editing = new ClientModel();

    private void Edit(ClientModel client) => editing = new ClientModel
    {
        Id = client.Id,
        Name = client.Name,
        Email = client.Email,
        Phone = client.Phone,
        ClientType = client.ClientType
    };

    private void Cancel() => editing = null;

    private async Task SaveAsync()
    {
        if (editing is null)
        {
            return;
        }

        busy = true;
        StateHasChanged();
        try
        {
            await Api.SaveClientAsync(editing);
            editing = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync(ClientModel client)
    {
        busy = true;
        StateHasChanged();
        try
        {
            await Api.DeleteClientAsync(client.Id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
