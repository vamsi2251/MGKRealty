<div class="top-row ps-3 navbar navbar-dark" style="position: relative;">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MGK Realty</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <AuthorizeView>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
                </NavLink>
            </div>
        </AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="agents">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Agents
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="clients">
                <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Clients
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin,SuperAdmin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="inquiries">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Inquiries
                </NavLink>
            </div>
        </AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="layouts">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Sketches
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin,SuperAdmin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/users">
                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Users
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <button class="nav-link btn btn-link" @onclick="SignOutAsync">Sign out</button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">Sign in</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@inject JwtAuthStateProvider Auth
@inject NavigationManager Navigation

@code {
    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();
        Navigation.NavigateTo("/login");
    }
}

