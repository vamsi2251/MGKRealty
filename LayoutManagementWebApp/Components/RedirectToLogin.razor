@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (relative.StartsWith("login", StringComparison.OrdinalIgnoreCase)
            || relative.StartsWith("signup", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var returnUrl = string.IsNullOrEmpty(relative) ? "/" : "/" + relative;
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
    }
}
